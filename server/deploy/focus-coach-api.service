# Install to /etc/systemd/system/focus-coach-api.service
[Unit]
Description=Focus Coach API
After=network.target

[Service]
Type=simple
User=focuscoach
WorkingDirectory=/opt/focus-coach/server
EnvironmentFile=/opt/focus-coach/server/.env
ExecStart=/opt/focus-coach/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=always
RestartSec=3

# The service should not be able to touch anything but its own data.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/focus-coach

[Install]
WantedBy=multi-user.target
