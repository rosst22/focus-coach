# Copy to .env on the server and fill in. Never commit the real file.

# The one key that pays for everyone. Yours, not the user's.
ANTHROPIC_API_KEY=sk-ant-...

# Which model each plan gets. Free tier is Haiku because it is ~5x cheaper
# per token than Opus and this is a short classification, not deep reasoning.
FREE_MODEL=claude-haiku-4-5
PRO_MODEL=claude-opus-5
FREE_DAILY_CALLS=200
PRO_DAILY_CALLS=2000

# Email, for the 6-digit sign-in codes. resend.com free tier is 3k/month.
RESEND_API_KEY=re_...
MAIL_FROM=Focus Coach <login@yourdomain.com>

# Set to 1 ONLY in local dev: prints the login code to the log instead of
# emailing it, so you can test without Resend configured.
DEV_ECHO_CODES=0

# Stripe. Leave blank until you actually want to charge money — the billing
# routes return 503 and everything else still works.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_RETURN_URL=https://yourdomain.com/thanks

DB_PATH=/var/lib/focus-coach/app.db
